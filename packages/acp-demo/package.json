{
  "name": "@fsio/acp-demo",
  "version": "0.0.1",
  "private": true,
  "description": "fsio /acp demo: page + native helper (a browser page that is an ACP client, driving a sandboxed local agent over the folder)",
  "type": "module",
  "bin": {
    "fsio-acp-helper": "./dist/helper.js"
  },
  "scripts": {
    "build": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty",
      "files": ["src/**", "tsconfig.json", "../../tsconfig.base.json"],
      "output": ["dist/**"],
      "clean": "if-file-deleted",
      "dependencies": ["../host:build", "../client:build", "../bench:build"]
    },
    "test": {
      "command": "node --test --test-concurrency=1 dist/test-framing.js dist/test-acp-kind.js dist/test-sandbox.js",
      "files": ["../host/src/**", "../client/src/**"],
      "output": [],
      "dependencies": ["build", "../bench:build"]
    }
  },
  "dependencies": {
    "@fsio/client": "*",
    "@fsio/host": "*"
  },
  "devDependencies": {
    "@fsio/bench": "*"
  }
}
