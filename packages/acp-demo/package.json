{
  "name": "@fsio/acp-demo",
  "version": "0.0.1",
  "private": true,
  "description": "fsio /acp demo: page + native helper (a browser page that is an ACP client, driving a sandboxed local agent over the folder)",
  "type": "module",
  "bin": {
    "fsio-acp-helper": "./dist/helper.js"
  },
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "dev": "vite"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty && tsc --pretty -p web/tsconfig.json && vite build --logLevel warn",
      "files": [
        "src/**",
        "web/**",
        "vite.config.ts",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**",
        "dist-web/**"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "../host:build",
        "../client:build",
        "../bench:build"
      ]
    },
    "test": {
      "command": "node --test --test-concurrency=1 dist/test-framing.js dist/test-paths.js dist/test-acp-kind.js dist/test-sandbox.js",
      "files": [
        "../host/src/**",
        "../client/src/**"
      ],
      "output": [],
      "dependencies": [
        "build",
        "../bench:build"
      ]
    }
  },
  "dependencies": {
    "@fsio/client": "*",
    "@fsio/host": "*",
    "@lit-labs/signals": "^0.1.3",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@fsio/bench": "*"
  }
}
