{
  "name": "pewter-ui",
  "version": "0.0.1",
  "private": true,
  "description": "The look the scaffolded screens share: tokens, base styles, and typed elements an extension imports",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./style.css"
  },
  "scripts": {
    "build": "wireit",
    "bundle": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty",
      "files": [
        "src/**",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted"
    },
    "bundle": {
      "command": "node scripts/make-artifact.mjs",
      "files": [
        "scripts/make-artifact.mjs",
        "artifact/**",
        "style.css"
      ],
      "output": [
        "artifact-dist/**"
      ],
      "dependencies": [
        "build"
      ]
    },
    "test": {
      "command": "node --test dist/test-markdown.js",
      "files": [],
      "output": [],
      "dependencies": [
        "build"
      ]
    }
  },
  "peerDependencies": {
    "@lit-labs/signals": "^0.1.3",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@lit-labs/signals": "^0.1.3",
    "lit": "^3.3.0"
  }
}
