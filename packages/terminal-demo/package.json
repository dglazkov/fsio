{
  "name": "@fsio/terminal-demo",
  "version": "0.0.1",
  "private": true,
  "description": "fsio /terminal demo: native helper (sandboxed working-folder shell over @fsio/host)",
  "type": "module",
  "bin": {
    "fsio-terminal-helper": "./dist/helper.js"
  },
  "scripts": {
    "build": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty",
      "files": ["src/**", "tsconfig.json", "../../tsconfig.base.json"],
      "output": ["dist/**"],
      "clean": "if-file-deleted",
      "dependencies": ["../host:build"]
    },
    "test": {
      "command": "node --test --test-concurrency=1 dist/test-sandbox.js",
      "files": ["../host/src/**"],
      "output": [],
      "dependencies": ["build"]
    }
  },
  "dependencies": {
    "@fsio/host": "*",
    "node-pty": "^1.1.0"
  }
}
