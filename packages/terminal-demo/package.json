{
  "name": "@fsio/terminal-demo",
  "version": "0.0.1",
  "private": true,
  "description": "fsio /terminal demo: page + native helper (sandboxed working-folder shell over @fsio/host)",
  "type": "module",
  "bin": {
    "fsio-terminal-helper": "./dist/helper.js"
  },
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "bundle": "wireit",
    "dev": "vite"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty && tsc --pretty -p web/tsconfig.json && vite build --logLevel warn",
      "files": [
        "src/**",
        "web/**",
        "vite.config.ts",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**",
        "dist-web/**"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "../confine:build",
        "../host:build",
        "../client:build",
        "../ui:build"
      ]
    },
    "test": {
      "command": "node --test --test-concurrency=1 dist/test-sandbox.js",
      "files": [
        "../host/src/**",
        "../confine/src/**"
      ],
      "output": [],
      "dependencies": [
        "build"
      ]
    },
    "bundle": {
      "command": "node scripts/make-artifact.mjs",
      "files": [
        "scripts/make-artifact.mjs",
        "artifact/**"
      ],
      "output": [
        "artifact-dist/**"
      ],
      "dependencies": [
        "build"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fsio/client": "*",
    "@fsio/confine": "*",
    "@fsio/host": "*",
    "@fsio/ui": "*",
    "@lit-labs/signals": "^0.1.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lit": "^3.3.0",
    "node-pty": "^1.1.0"
  }
}
