{
  "name": "@fsio/bench",
  "version": "0.0.1",
  "private": true,
  "description": "fsio benchmarks and protocol integration smoke test",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty",
      "files": ["src/**", "tsconfig.json", "../../tsconfig.base.json"],
      "output": ["dist/**"],
      "clean": "if-file-deleted",
      "dependencies": ["../common:build", "../client:build", "../host:build"]
    },
    "test": {
      "command": "node --test --test-concurrency=1 dist/test-protocol.js dist/test-lifecycle.js dist/test-client.js && node dist/test-smoke.js",
      "files": ["../host/src/**", "../common/src/**", "../client/src/**"],
      "output": [],
      "dependencies": ["build", "../host:build"]
    }
  },
  "dependencies": {
    "@fsio/client": "*",
    "@fsio/common": "*",
    "@fsio/host": "*"
  }
}
