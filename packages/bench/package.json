{
  "name": "@fsio/bench",
  "version": "0.0.1",
  "private": true,
  "description": "fsio benchmarks and protocol integration smoke test",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "node ../../scripts/check-syntax.mjs .",
      "files": ["*.js", "*.mjs", "../../scripts/check-syntax.mjs"],
      "output": [],
      "dependencies": ["../common:build"]
    },
    "test": {
      "command": "node test-smoke.mjs",
      "files": ["*.js", "*.mjs", "../host/*.js"],
      "output": [],
      "dependencies": ["build", "../host:build"]
    }
  },
  "dependencies": {
    "@fsio/common": "*"
  }
}
