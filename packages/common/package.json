{
  "name": "@fsio/common",
  "version": "0.0.1",
  "private": true,
  "description": "fsio protocol core: frame codec, JSON-RPC control plane, protocol schemas",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "test": {
      "command": "node --test dist/*.test.js",
      "files": [],
      "output": [],
      "dependencies": ["build"]
    },
    "build": {
      "command": "tsc --pretty",
      "files": ["src/**", "tsconfig.json", "../../tsconfig.base.json"],
      "output": ["dist/**"],
      "clean": "if-file-deleted"
    }
  }
}
