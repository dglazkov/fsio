{
  "name": "@fsio/host",
  "version": "0.0.1",
  "private": true,
  "description": "fsio native host: session server over a shared directory",
  "type": "module",
  "scripts": {
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty",
      "files": ["src/**", "tsconfig.json", "../../tsconfig.base.json"],
      "output": ["dist/**"],
      "clean": "if-file-deleted",
      "dependencies": ["../common:build"]
    }
  },
  "dependencies": {
    "@fsio/common": "*"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
