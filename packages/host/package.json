{
  "name": "@fsio/host",
  "version": "0.0.1",
  "private": true,
  "description": "fsio native host: session server over a shared directory",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "wireit",
    "bundle": "wireit"
  },
  "wireit": {
    "bundle": {
      "command": "node scripts/make-artifact.mjs",
      "files": ["scripts/make-artifact.mjs", "../../scripts/verbatim-artifact.mjs", "artifact/**", "README.md"],
      "output": ["artifact-dist/**"],
      "dependencies": ["build"]
    },
    "build": {
      "command": "tsc --pretty",
      "files": ["src/**", "tsconfig.json", "../../tsconfig.base.json"],
      "output": ["dist/**"],
      "clean": "if-file-deleted",
      "dependencies": ["../common:build"]
    }
  },
  "dependencies": {
    "@fsio/common": "*"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
