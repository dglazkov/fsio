{
  "name": "@fsio/ui",
  "version": "0.0.1",
  "private": true,
  "description": "fsio demo chrome: the tab strip, wizard frame, session row and diagnostics popover both demo pages had written twice, plus the tokens under them",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty",
      "files": [
        "src/**",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "node --test --test-concurrency=1 dist/test-text.js",
      "files": [],
      "output": [],
      "dependencies": [
        "build"
      ]
    }
  },
  "dependencies": {
    "@lit-labs/signals": "^0.1.3",
    "lit": "^3.3.0"
  }
}
