{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // A browser package: DOM for the components, no Node types at all — the
    // one pure module (text.ts) is what the node-side tests import, and it
    // touches neither.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Node only for `node:test` in test-text.ts. Every timer handle in here
    // is typed `ReturnType<typeof setInterval>` so the DOM/Node disagreement
    // about what a timer is never has to be settled.
    "types": ["node"],
    // Lit's `static properties` installs accessors on the prototype; an
    // ES2022 class field would define an own property over the top of them
    // and the element would stop reacting. This is Lit's documented setting
    // for TypeScript without decorators.
    "useDefineForClassFields": false
  },
  "include": ["src"]
}
