{
  "name": "@fsio/web",
  "version": "0.0.1",
  "private": true,
  "description": "fsio browser client and workbench page",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "preview": "vite preview"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty && vite build --logLevel warn",
      "files": ["src/**", "index.html", "vite.config.ts", "tsconfig.json", "../../tsconfig.base.json"],
      "output": ["dist/**"],
      "clean": "if-file-deleted",
      "dependencies": ["../common:build"]
    }
  },
  "dependencies": {
    "@fsio/common": "*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  }
}
