{
  "name": "@fsio/pewter-shell",
  "version": "0.0.1",
  "private": true,
  "description": "The Pewter shell: the page that holds tabs, loads extensions into sandboxed iframes, and provides the pewt API",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "dev": "vite"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty -p web/tsconfig.json && vite build --logLevel warn",
      "files": ["web/**", "vite.config.ts", "../../tsconfig.base.json"],
      "output": ["dist-web/**"],
      "clean": "if-file-deleted",
      "dependencies": ["../client:build", "../common:build", "../ui:build", "../pewter:build"]
    }
  },
  "dependencies": {
    "@fsio/client": "*",
    "@fsio/common": "*",
    "@fsio/ui": "*",
    "@lit-labs/signals": "^0.1.3",
    "lit": "^3.3.0",
    "pewter": "*"
  }
}
