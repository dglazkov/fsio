{
  "name": "fsio",
  "version": "0.0.1",
  "description": "A file-system bridge between stdio and the Web Platform FS API",
  "author": "Dimitri Glazkov <dimitri@glazkov.com>",
  "repository": "github:dglazkov/fsio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.6"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "host": "node packages/host/dist/fsio-host.js",
    "fsio": "node packages/fsiod/dist/cli.js",
    "fsiod": "node packages/fsiod/dist/fsiod.js",
    "bench": "node packages/bench/dist/node-client.js",
    "dev": "scripts/dev.sh",
    "harness": "node scripts/browser-harness.mjs",
    "bg-lab": "node scripts/background-lab.mjs",
    "cost-lab": "node scripts/cost-lab.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "check-anchors": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "./packages/common:build",
        "./packages/client:build",
        "./packages/host:build",
        "./packages/fsiod:build",
        "./packages/workbench:build",
        "./packages/terminal-demo:build",
        "./packages/bench:build"
      ]
    },
    "test": {
      "dependencies": [
        "./packages/common:test",
        "./packages/bench:test",
        "./packages/fsiod:test",
        "./packages/terminal-demo:test",
        "check-anchors"
      ]
    },
    "check-anchors": {
      "command": "node scripts/check-anchors.mjs",
      "files": [
        "scripts/check-anchors.mjs",
        "spec/*.md",
        "TESTING.md",
        "README.md",
        "AGENTS.md"
      ],
      "output": []
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wireit": "^0.14.0"
  }
}
