{
  "name": "fsio",
  "version": "0.0.1",
  "description": "A file-system bridge between stdio and the Web Platform FS API",
  "author": "Dimitri Glazkov <dimitri@glazkov.com>",
  "repository": "github:dglazkov/fsio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "host": "node packages/host/fsio-host.js",
    "serve": "node packages/host/serve.js",
    "bench": "node packages/bench/node-client.js",
    "dev": "scripts/dev.sh",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "./packages/common:build",
        "./packages/host:build",
        "./packages/web:build",
        "./packages/bench:build"
      ]
    },
    "test": {
      "dependencies": [
        "./packages/bench:test"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wireit": "^0.14.0"
  }
}
